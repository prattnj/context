# Copy to .env and fill in. Used by the server, docker-compose, and scripts/import.py.

# MySQL (host machine's own instance, database name: context)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=context
DB_PASSWORD=
DB_NAME=context

# Frontend password (the one simple password protecting the site)
APP_PASSWORD=

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gemini (for month summaries)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# External port docker-compose maps to the container's 3000
PORT_CONTEXT=3100
